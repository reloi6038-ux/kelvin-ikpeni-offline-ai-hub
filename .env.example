# ===========================================
# Kelvin Ikpeni Offline AI Learning Hub
# Environment Configuration (example file)
# Copy this to .env and fill in real values
# ===========================================

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Local:    mongodb://127.0.0.1:27017/kelvin_hub
# Atlas:    mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/kelvin_hub
MONGODB_URI=mongodb://127.0.0.1:27017/kelvin_hub

# --- AI Provider ---
# Supported values: gemini | openai | deepseek | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Security ---
# Used only if you enable auth later; generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string
SESSION_SECRET=change_me_too

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Feature Flags ---
ENABLE_AUTH=false
ENABLE_LOCAL_CLASSROOM=true